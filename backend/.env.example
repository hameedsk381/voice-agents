# ==============================================================================
# Voise AI — Environment Variables
# Copy to '.env' in the project root and fill in your credentials.
# ==============================================================================

# --- Core ---
ENVIRONMENT=dev
SECRET_KEY=change-this-to-a-random-secret-in-production

# --- Voice Runtime ---
# livekit = LiveKit Agents + WebRTC (recommended)
# custom  = legacy WebSocket turn processor
VOICE_RUNTIME=livekit

# --- LiveKit Cloud (required) ---
# Create an account at https://livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=voise-livekit-agent

# --- Google Cloud Pipeline (default) ---
# STT model: latest_long | chirp_3 | etc.
LIVEKIT_STT_MODEL=latest_long
LIVEKIT_STT_LANGUAGE=hi-IN
# LLM model: gemini-2.5-flash | gemini-2.0-flash | etc.
# Uses GOOGLE_API_KEY (Gemini Developer API) or Vertex AI
LIVEKIT_LLM_MODEL=gemini-2.5-flash
# TTS voice: hi-IN-Wavenet-A | en-US-Standard-H | etc.
# Uses GOOGLE_APPLICATION_CREDENTIALS (Cloud Text-to-Speech)
LIVEKIT_TTS_VOICE=hi-IN-Wavenet-A

# Google AI API key (for Gemini LLM) — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-gemini-api-key

# Google Cloud service account JSON (for STT + TTS)
# Enable Cloud Speech-to-Text API and Cloud Text-to-Speech API in GCP
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account-key.json

# --- Groq Pipeline (alternative) ---
# Uncomment to switch from Google to Groq
# LIVEKIT_STT_MODEL=whisper-large-v3-turbo
# LIVEKIT_STT_LANGUAGE=en
# LIVEKIT_LLM_MODEL=llama-3.3-70b-versatile
# LIVEKIT_TTS_MODEL=canopylabs/orpheus-v1-english
# LIVEKIT_TTS_VOICE=autumn
# GROQ_API_KEY=your-groq-api-key

# --- Custom Runtime Providers (when VOICE_RUNTIME=custom) ---
# STT: mock | deepgram | sarvam | google | groq
STT_PROVIDER=google
# TTS: qwen | deepgram | sarvam | google | groq
TTS_PROVIDER=google

# --- Sarvam AI (Indian language STT/TTS) ---
# SARVAM_API_KEY=your-sarvam-api-key

# --- Database (PostgreSQL) ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=voise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Cache (Redis) ---
REDIS_HOST=redis
REDIS_PASSWORD=secure_redis_password_2026

# --- Workflow Engine (Temporal) ---
TEMPORAL_HOST=temporal:7233

# --- Telephony (multi-provider) ---
# Set TELEPHONY_PROVIDER to one of: twilio | vonage | plivo | telnyx
TELEPHONY_PROVIDER=twilio

# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15550001111

# Vonage (Nexmo) credentials
# VONAGE_API_KEY=your-vonage-api-key
# VONAGE_API_SECRET=your-vonage-api-secret
# VONAGE_APPLICATION_ID=your-vonage-app-id
# VONAGE_PRIVATE_KEY=./vonage-private.key

# Plivo credentials
# PLIVO_AUTH_ID=your-plivo-auth-id
# PLIVO_AUTH_TOKEN=your-plivo-auth-token

# Telnyx credentials
# TELNYX_API_KEY=your-telnyx-api-key

# --- WhatsApp (Twilio WhatsApp Business API) ---
# TWILIO_WHATSAPP_SENDER=whatsapp:+14155238886

# --- Email (workflow automation — optional SMTP) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=secret
# SMTP_FROM=notifications@yourcompany.com

# --- Observability ---
LOG_FORMAT=text
METRICS_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Public Host (for Twilio webhooks) ---
SERVER_HOST=localhost:8001
