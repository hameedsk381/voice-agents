# ==============================================================================
# Voise AI — Environment Variables
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# --- Core Configuration ---
PROJECT_NAME="Voise AI"
API_V1_STR="/api/v1"
ENVIRONMENT="dev" # Options: dev, staging, prod
SECRET_KEY="your-super-secret-key-change-in-production-use-a-secure-random-string"
COOKIE_SECURE=false # Set to true in production with HTTPS
# JSON array or comma-separated. Include every frontend origin you use in dev.
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3001", "http://127.0.0.1:3001"]

# --- Database (PostgreSQL) ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5435 # Matches the custom external port in docker-compose
POSTGRES_DB="voise"

# --- Cache and Queue (Redis) ---
REDIS_HOST="localhost"
REDIS_PORT=6379

# --- Workflow Engine (Temporal) ---
TEMPORAL_HOST="localhost:7233"

# --- LLM and Audio API Keys (Optional/Used as configured) ---
OPENAI_API_KEY="your-openai-api-key"
GROQ_API_KEY="your-groq-api-key"
DEEPGRAM_API_KEY="your-deepgram-api-key"
# Anthropic Claude — used for high-stakes reasoning (compliance audit, outcome
# classification). When set, these tasks use Claude; otherwise they fall back to Groq 70B.
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Reasoning model selection: auto | anthropic | openai | groq (auto prefers Claude if keyed)
REASONING_LLM_PROVIDER="auto"
# Optional explicit model override (e.g. claude-opus-4-8 for the strictest auditing)
# REASONING_LLM_MODEL="claude-sonnet-4-6"
# STT: mock (local dev) | deepgram (production)
STT_PROVIDER="mock"
DEFAULT_STT_CONFIDENCE=0.85
DEFAULT_STT_CONFIDENCE_FLOOR=0.5
# Mock STT tuning (only when STT_PROVIDER=mock)
MOCK_STT_TEXT="This is a simulated transcription of the user's voice."
MOCK_STT_CONFIDENCE=0.85

# --- Voice Runtime (Ultravox — recommended) ---
# ultravox = STT + LLM + TTS via Ultravox client SDK (WebRTC) or Twilio medium
# custom = legacy custom turn processor (Groq + Mock/Deepgram STT + Qwen TTS)
VOICE_RUNTIME="ultravox"
USE_ULTRAVOX_RUNTIME=true
USE_ULTRAVOX_WEBSOCKET_PROXY=false
ULTRAVOX_API_KEY="your-ultravox-api-key"
ULTRAVOX_BASE_URL="https://api.ultravox.ai/api"
ULTRAVOX_MODEL="fixie-ai/ultravox-70B"
ULTRAVOX_VOICE="Mark"
ULTRAVOX_INPUT_SAMPLE_RATE=48000
ULTRAVOX_OUTPUT_SAMPLE_RATE=48000
ULTRAVOX_CLIENT_BUFFER_MS=60
# Voise agents sync to Ultravox Agents on create/update; config.ultravox_agent_id is stored automatically.
# Manual re-sync: POST /api/v1/agents/{agent_id}/sync-ultravox
# Playground join uses POST /agents/{ultravox_agent_id}/calls when synced.
# Twilio inbound/outbound uses the same agent-call path with medium + dataConnection overrides.
# Pinning a version re-syncs the template; deleting a Voise agent deletes the Ultravox agent.
# Phase 3: per-call toolOverrides (no template flip), call.ended webhooks, campaign greetings.
ULTRAVOX_CALLBACKS_ENABLED=true
ULTRAVOX_CALLBACK_SECRET="your-webhook-signing-secret"
# ULTRAVOX_CALL_ENDED_WEBHOOK_URL="https://your-ngrok.ngrok.io/api/v1/ultravox/webhooks/call-ended"

# --- Telephony (Twilio Integration) ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15550001111"

# --- India Telephony Compliance (TRAI / TCCCPR / DLT) ---
# AI-disclosure spoken at the start of every call. {company} is substituted from agent config.
AI_DISCLOSURE_REQUIRED=true
AI_DISCLOSURE_TEMPLATE="This is an AI assistant calling on behalf of {company}."
# Permitted commercial calling window in IST (24h). TCCCPR restricts to 9am-9pm.
CALLING_HOURS_START=9
CALLING_HOURS_END=21
CALLING_HOURS_ENFORCED=true
# When true, refuse outbound from numbers whose dlt_status != "registered".
# Keep false in dev (Twilio test numbers are not DLT-registered); set true in production.
DLT_ENFORCEMENT=false

# --- Razorpay (collections payment links) ---
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
# RAZORPAY_KEY_SECRET="your-razorpay-secret"
# RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# --- Public Live Demo (homepage "Call Me Now") ---
# Seed an agent with: python -m scripts.seed_demo_agent  → then paste the printed id here.
# Requires a DLT-registered TWILIO_PHONE_NUMBER in production (or DLT_ENFORCEMENT=false in dev).
# DEMO_AGENT_ID=""

# --- WhatsApp (Twilio WhatsApp Business API) ---
# Sender WhatsApp number (must be approved by Meta for WhatsApp Business)
TWILIO_WHATSAPP_SENDER="whatsapp:+14155238886"
# Public URL for Twilio to send delivery status callbacks (e.g., https://your-ngrok.ngrok.io/api/v1/workflows/whatsapp/callback)
# TWILIO_STATUS_CALLBACK_URL="https://your-domain.com/api/v1/workflows/whatsapp/callback"
# Rate limit: max WhatsApp messages per phone number per hour (0 = unlimited)
WHATSAPP_RATE_LIMIT_PER_HOUR=0
# Require user opt-in before sending non-reply messages
WHATSAPP_OPTIN_REQUIRED=true
# Namespace for Twilio Content API templates (optional)
# WHATSAPP_TEMPLATE_NAMESPACE=""

# --- Email (workflow automation — optional SMTP) ---
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASSWORD="secret"
# SMTP_FROM="collections@yourcompany.com"
# SMTP_USE_TLS=true

# --- Observability (OpenTelemetry + Prometheus + Logging) ---
# LOG_FORMAT="json" enables structured JSON logging; "text" for human-readable
LOG_FORMAT="text"
# Set METRICS_ENABLED=false to disable the /metrics endpoint entirely
METRICS_ENABLED=true
# OpenTelemetry OTLP endpoint (e.g., Grafana Tempo, SigNoz, self-hosted collector)
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer your-token"

# --- Public Host (Used by Twilio Webhook callbacks) ---
# Must be accessible from the public internet (e.g., ngrok public URL in local development)
SERVER_HOST="localhost:8001"
